PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=data/vexel.sqlite
GAME_CONTENT_DIR=../vex-games
# Set a separate deployment/origin for untrusted third-party game content.
GAME_CONTENT_ORIGIN=
BUILTIN_WISP=true
# Optional external transport override:
WISP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Use consumers, common, or a tenant UUID, matching the registered app.
MICROSOFT_TENANT=consumers
ADMIN_USERNAMES=
# GamePlaza's existing request platform; leave enabled to submit there.
FEEDBACK_PROJECT=gplaza-feedback
FEEDBACK_API_KEY=

# Optional: keep feedback locally without contacting GamePlaza.
FEEDBACK_DRAFT_ONLY=false
