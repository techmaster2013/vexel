#!/bin/sh
# Network setup and boot trimming for an emulated PC.
set -e
# DHCP in the background with systemd-networkd; DNS through systemd-resolved.
systemctl enable systemd-networkd.service systemd-resolved.service
# Don't wait for the network at boot (it may be turned off in Vexel).
systemctl mask systemd-networkd-wait-online.service
ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
# LightDM autologin needs the autologin group to exist.
getent group autologin >/dev/null || groupadd -r autologin
systemctl mask apt-daily.timer apt-daily-upgrade.timer man-db.timer e2scrub_all.timer fstrim.timer 2>/dev/null || true
apt-get clean
# Keep /usr/share/doc: it holds the packages' copyright files, which must ship with the image.
rm -rf /var/lib/apt/lists/* /usr/share/man/* /usr/share/info/*
