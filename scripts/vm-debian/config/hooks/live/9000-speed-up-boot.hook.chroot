#!/bin/sh
# Trim boot work that only slows down an emulated PC.
set -e
# Don't hold boot for a DHCP lease when Vexel's VM network is off.
mkdir -p /etc/systemd/system/networking.service.d
printf '[Service]\nTimeoutStartSec=15\n' > /etc/systemd/system/networking.service.d/short-timeout.conf
systemctl mask apt-daily.timer apt-daily-upgrade.timer man-db.timer e2scrub_all.timer fstrim.timer 2>/dev/null || true
apt-get clean
# Keep /usr/share/doc: it holds the packages' copyright files, which must ship with the image.
rm -rf /var/lib/apt/lists/* /usr/share/man/* /usr/share/info/*
